{
  "schemaVersion": 1,
  "id": "flowfocus",
  "name": "FocusFlow",
  "version": "1.5.0",
  "author": "kamal",
  "description": "FocusFlow — Pomodoro timer with tick-tock sound and a to-do list with plain/kanban modes",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "keepLoaded": true,
  "barWidget": {
    "displayName": "FocusFlow",
    "description": "FocusFlow — Pomodoro timer with tick-tock sound and a to-do list with plain/kanban modes",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "workSec": 1500,
      "shortBreakSec": 300,
      "longBreakSec": 900,
      "longBreakInterval": 4,
      "tickEnabled": false,
      "tickVolume": 0.3,
      "alarmEnabled": true,
      "alarmVolume": 0.5,
      "soundMuted": false,
      "kanbanMode": false,
      "showPomodoros": true,
      "autoStartBreaks": false,
      "autoStartWork": false,
      "notificationsEnabled": true,
      "obsidianEnabled": false,
      "obsidianVaultPath": ""
    },
    "schema": [
      {
        "key": "workSec",
        "type": "int",
        "label": "Work duration (seconds)"
      },
      {
        "key": "shortBreakSec",
        "type": "int",
        "label": "Short break (seconds)"
      },
      {
        "key": "longBreakSec",
        "type": "int",
        "label": "Long break (seconds)"
      },
      {
        "key": "longBreakInterval",
        "type": "int",
        "label": "Cycles before long break"
      },
      {
        "key": "tickEnabled",
        "type": "bool",
        "label": "Tick sound while running"
      },
      {
        "key": "tickVolume",
        "type": "real",
        "label": "Tick volume (0.0-1.0)"
      },
      {
        "key": "alarmEnabled",
        "type": "bool",
        "label": "Alarm sound on phase end"
      },
      {
        "key": "alarmVolume",
        "type": "real",
        "label": "Alarm volume (0.0-1.0)"
      },
      {
        "key": "soundMuted",
        "type": "bool",
        "label": "Mute all sounds (bell / M key)"
      },
      {
        "key": "kanbanMode",
        "type": "bool",
        "label": "Use kanban board instead of plain list"
      },
      {
        "key": "todoEnabled",
        "type": "bool",
        "label": "Enable To-Do view"
      },
      {
        "key": "kanbanEnabled",
        "type": "bool",
        "label": "Enable Kanban view"
      },
      {
        "key": "showPomodoros",
        "type": "bool",
        "label": "Show pomodoro counter on kanban cards"
      },
      {
        "key": "autoStartBreaks",
        "type": "bool",
        "label": "Auto-start breaks"
      },
      {
        "key": "autoStartWork",
        "type": "bool",
        "label": "Auto-start next work session"
      },
      {
        "key": "notificationsEnabled",
        "type": "bool",
        "label": "Desktop notifications on phase end"
      },
      {
        "key": "obsidianEnabled",
        "type": "bool",
        "label": "Push tasks to notes app (manual approve)"
      },
      {
        "key": "obsidianVaultPath",
        "type": "string",
        "label": "Notes folder path (Obsidian, Logseq, or any markdown app)"
      }
    ]
  }
}